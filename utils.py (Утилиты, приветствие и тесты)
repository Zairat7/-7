import datetime

def get_greeting() -> str:
    """Возвращает приветствие в зависимости от текущего времени суток."""
    hour = datetime.datetime.now().hour
    if 5 <= hour < 12:
        return "Доброе утро"
    elif 12 <= hour < 18:
        return "Добрый день"
    elif 18 <= hour < 23:
        return "Добрый вечер"
    else:
        return "Доброй ночи"

def run_tests():
    """Автоматические тесты (assert) для проверки бизнес-логики."""
    from models import Volunteer
    
    # Тест 1: Инициализация и инкапсуляция
    v = Volunteer(1, "Иван", "Москва", 5)
    assert v.name == "Иван"
    assert v.lessons == 5
    
    # Тест 2: Метод добавления занятий
    v.add_lesson()
    assert v.lessons == 6
    
    # Тест 3: Сериализация в строку
    assert v.to_string() == "1;Иван;Москва;6"
    
    # Тест 4: Десериализация из строки
    v_from_str = Volunteer.from_string("2;Мария;Казань;10")
    assert v_from_str.id == 2
    assert v_from_str.name == "Мария"
    assert v_from_str.lessons == 10
    
    print("[УСПЕХ] Все внутренние тесты пройдены без ошибок!")
